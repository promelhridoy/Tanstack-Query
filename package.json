    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "json-server": "1.0.0-beta.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
